{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloudskill-hub",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {"directory":"./public", "binding":"ASSETS", "run_worker_first":true},
  "d1_databases": [{"binding":"DB", "database_name":"cloudskill_hub", "database_id":"REPLACE_WITH_YOUR_D1_DATABASE_ID", "migrations_dir":"migrations"}],
  "r2_buckets": [{"binding":"BUCKET", "bucket_name":"cloudskill-hub"}]
}
