{
  "name": "cloudskill-hub",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "description": "Cloudflare-native private Agent Skills hub for Claude Code, Codex and Hermes Agent",
  "engines": {
    "node": ">=22.16"
  },
  "bin": {
    "cloudskill": "./cli/cloudskill.mjs"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate": "wrangler d1 migrations apply DB --remote",
    "test": "node scripts/test.mjs",
    "check": "node scripts/check.mjs && npm test",
    "test:browser:server": "node test/browser-server.mjs",
    "reset-password": "node scripts/reset-password.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  },
  "license": "MIT",
  "keywords": [
    "agent-skills",
    "hermes-agent",
    "codex",
    "claude-code",
    "cloudflare",
    "skill-hub"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lanchenglin/cloudskill-hub.git"
  }
}
